# Operational Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True

# FastAPI Configuration
PROJECT_NAME="OpsPilot Backend API"
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_super_secret_key_in_production_32_bytes_min

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=opspilot_user
POSTGRES_PASSWORD=opspilot_password
POSTGRES_DB=opspilot_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM API Credentials (Required for Month 1 Agent Execution)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# JWT Auth Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
